generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model campaign_creative {
  campaign_id String    @db.Uuid
  creative_id String    @db.Uuid
  campaigns   campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creatives   creatives @relation(fields: [creative_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([campaign_id, creative_id])
}

model campaigns {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  start_date        DateTime?           @db.Date
  end_date          DateTime?           @db.Date
  age_groups        String[]
  gender            String?
  campaign_creative campaign_creative[]
}

model creatives {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  campaign_creative campaign_creative[]
}

model system_config {
  id        Int     @id @default(autoincrement())
  parameter String?
  value     String
}
